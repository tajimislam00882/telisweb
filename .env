
# Supabase Credentials
# These are required for the application to connect to your Supabase project.
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Payment Gateway Credentials (Example for SSLCommerz)
# Add other payment gateway keys as needed.
SSLCZ_STORE_ID="your-store-id"
SSLCZ_STORE_PASSWORD="your-store-password"

# Google API Keys (if used for services like translation)
GOOGLE_TRANSLATE_API_KEY="your-google-translate-api-key"

# The base URL of your production website
# This is important for generating correct absolute URLs for callbacks, etc.
NEXT_PUBLIC_BASE_URL="https://your-domain.com"
